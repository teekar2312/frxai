# ============================================================
# FINEX Indonesia - Environment Configuration
# ============================================================
# For local development:
#   cp .env.example .env
#
# For production (Docker):
#   cp .env.example .env.production
#   Fill in ALL required values, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Generate secrets with: openssl rand -hex 32
# ============================================================

# ============================================================
# REQUIRED — Application will not start without these
# ============================================================

# NextAuth.js session encryption (REQUIRED in production)
NEXTAUTH_SECRET=

# API mutation protection (REQUIRED in production)
API_SECRET_KEY=

# Public domain for production (REQUIRED for Docker + Caddy)
FINEX_DOMAIN=

# Email for Let's Encrypt certificate alerts (REQUIRED for Docker + Caddy)
CADDY_ADMIN_EMAIL=

# ============================================================
# Database (SQLite — auto-initialized by Docker entrypoint)
# ============================================================
DATABASE_URL=file:/app/data/custom.db

# ============================================================
# PostgreSQL (optional — overrides SQLite when set)
# ============================================================
# For PostgreSQL mode, use the postgres overlay:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
#
# For production with PG:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml \
#     -f docker-compose.prod.yml -f docker-compose.postgres.prod.yml up -d
#
# Generate password: openssl rand -hex 24
POSTGRES_USER=finex
POSTGRES_PASSWORD=
POSTGRES_DB=finex
# Expose PG port to host (dev only — omit in production)
POSTGRES_PORT=5432

# pgAdmin (optional, debug profile only)
#   docker compose --profile debug -f docker-compose.yml -f docker-compose.postgres.yml up -d
PGADMIN_EMAIL=admin@finex.local
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ============================================================
# Authentication
# ============================================================
# Allow new user registration (default: false for security)
ALLOW_REGISTRATION=false

# TOTP Secret Encryption Key (REQUIRED when 2FA is used)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This MUST be a 64-character hex string (32 bytes)
TOTP_ENCRYPTION_KEY=

# ============================================================
# Market Data Providers
# ============================================================
# Finnhub (https://finnhub.io/) — Free: 60 calls/min
FINNHUB_API_KEY=

# MARKETAUX (https://www.marketaux.com/) — Free: 100 requests/day
MARKETAUX_API_KEY=

# ============================================================
# AI Provider API Keys (at least one recommended)
# ============================================================
# Groq (https://console.groq.com/keys) — RECOMMENDED: fastest free tier
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Tinyfish.ai (https://tinyfish.ai/)
TINYFISH_API_KEY=

# Lokal AI (local Ollama — no key needed)
LOKAL_AI_API_KEY=
LOKAL_AI_BASE_URL=

# ============================================================
# MT5 Bridge (optional — for live trading)
# ============================================================
MT5_BRIDGE_URL=http://mt5-bridge:3004
MT5_BRIDGE_SECRET=

# ============================================================
# WebSocket Price Streaming (optional — built-in simulation works without)
# ============================================================
WS_PRICES_URL=http://ws-prices:3005

# ============================================================
# Email Notifications (optional — Resend)
# ============================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
NOTIFICATION_EMAIL_TO=

# ============================================================
# Logging
# ============================================================
# LOG_LEVEL=info (debug|info|warn|error)
