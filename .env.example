# ============================================================
# FINEX Indonesia - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# Database (SQLite)
DATABASE_URL=file:/app/data/custom.db

# ============================================================
# API Authentication
# ============================================================
# Required in production. Protects all POST/PUT/PATCH/DELETE endpoints.
# Generate with: openssl rand -hex 32
API_SECRET_KEY=

# ============================================================
# Market Data Providers
# ============================================================
# Finnhub (https://finnhub.io/) - Free: 60 calls/min
FINNHUB_API_KEY=

# MARKETAUX (https://www.marketaux.com/) - Free: 100 requests/day
MARKETAUX_API_KEY=

# ============================================================
# AI Provider API Keys
# ============================================================
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Tinyfish.ai (https://tinyfish.ai/)
TINYFISH_API_KEY=

# Lokal AI (local Ollama - no key needed)
LOKAL_AI_API_KEY=
LOKAL_AI_BASE_URL=

# ============================================================
# MT5 Bridge (optional - for live trading)
# ============================================================
MT5_BRIDGE_URL=http://localhost:3002
MT5_BRIDGE_SECRET=

# ============================================================
# Application
# ============================================================
# NODE_ENV is set automatically by the start script
# PORT=3000 (default, managed by Docker/infra)
