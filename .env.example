# ============================================
# FINEX AI Trader - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   Windows:  copy .env.example .env
#   Git Bash: cp .env.example .env
#
# NEVER commit your .env file to the repository!
# ============================================

# ============================================
# DATABASE (SQLite)
# ============================================
# Path to SQLite database file (relative to prisma/ folder)
DATABASE_URL="file:./db/custom.db"

# ============================================
# FINEX MT5 BROKER CONNECTION
# ============================================
# Your FINEX Indonesia MetaTrader 5 credentials
# Obtain from: FINEX Indonesia broker portal or MT5 terminal
MT5_LOGIN="your_mt5_account_number"
MT5_PASSWORD="your_mt5_account_password"
MT5_SERVER="FINEX-Server"

# ============================================
# NEWS API PROVIDERS
# ============================================
# Finnhub (https://finnhub.io/) — Free tier: 60 calls/min
FINNHUB_API_KEY="your_finnhub_api_key"

# MARKETAUX (https://www.marketaux.com/) — Free tier: 100 calls/day
MARKETAUX_API_KEY="your_marketaux_api_key"

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Base account balance in USD (for risk calculations)
BASE_BALANCE="10000"

# Node environment: development | production
NODE_ENV="development"

# ============================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================
# MT5 Python bridge URL (default: http://localhost:5000)
# MT5_BRIDGE_URL="http://localhost:5000"

# Server port (default: 3000)
# PORT="3000"

# Log level: DEBUG | INFO | WARN | ERROR
# LOG_LEVEL="INFO"

# Session risk limit (% of equity per session, default: 1.0)
# SESSION_RISK_LIMIT_PCT="1.0"
