# ============================================
# FRxAI (FINEX AI Trader) - Environment Configuration v2
# ============================================
# Copy this file to .env and fill in your values:
#   Windows:  copy .env.example .env
#   Git Bash: cp .env.example .env
#
# ALL variables are validated at runtime (src/lib/env-validation.ts):
#   - Invalid values in development → warning + safe default
#   - Invalid REQUIRED values in production → startup failure (fail-fast)
#
# NEVER commit your .env file to the repository!
# ============================================

# ============================================
# DATABASE (SQLite) — REQUIRED
# ============================================
DATABASE_URL="file:./db/custom.db"

# ============================================
# NODE ENVIRONMENT
# ============================================
# development | test | production
NODE_ENV="development"

# Force strict env validation even in development (optional)
# VALIDATE_ENV_STRICT="false"

# ============================================
# FINEX MT5 BROKER CONNECTION (required in production)
# ============================================
MT5_LOGIN="your_mt5_account_number"
MT5_PASSWORD="your_mt5_account_password"
MT5_SERVER="FINEX-Server"

# MT5 bridge URL (Python bridge or simulator; default http://localhost:3001)
MT5_BRIDGE_URL="http://localhost:3001"

# ============================================
# BRIDGE RETRY & CIRCUIT BREAKER (v2)
# ============================================
# Per-request timeout for bridge calls (ms)
BRIDGE_TIMEOUT_MS="15000"
# Retries for TRANSIENT failures (timeouts, resets, 5xx, 429)
BRIDGE_MAX_RETRIES="3"
# Exponential backoff base / cap (ms, full jitter applied)
BRIDGE_RETRY_BASE_DELAY_MS="500"
BRIDGE_RETRY_MAX_DELAY_MS="8000"
# Circuit breaker: failures before OPEN, recovery wait, half-open probes
CB_FAILURE_THRESHOLD="5"
CB_RECOVERY_TIMEOUT_MS="30000"
CB_HALF_OPEN_MAX_ATTEMPTS="1"
# Persist circuit breaker state to DB (survives restarts)
CB_PERSIST_ENABLED="true"

# ============================================
# NEWS API PROVIDERS (optional — features degrade gracefully)
# ============================================
# Finnhub (https://finnhub.io/) — Free tier: 60 calls/min
FINNHUB_API_KEY="your_finnhub_api_key"
# MARKETAUX (https://www.marketaux.com/) — Free tier: 100 calls/day
MARKETAUX_API_KEY="your_marketaux_api_key"

# ============================================
# LOGGING & ROTATION (v2 — configurable)
# ============================================
# DEBUG | INFO | WARN | ERROR | CRITICAL | FATAL
LOG_LEVEL="DEBUG"
# TradingLog retention (days)
LOG_RETENTION_DAYS="30"
# Mt5ConnectionLog retention (days)
MT5_LOG_RETENTION_DAYS="7"
# NewsFetchLog retention (days)
NEWS_LOG_RETENTION_DAYS="14"
# Rotation/cleanup cycle (hours)
LOG_CLEANUP_INTERVAL_HOURS="6"
# Cascading error dedup window (ms)
LOG_DEDUP_WINDOW_MS="60000"

# ============================================
# API RATE LIMITING (v2)
# ============================================
RATE_LIMIT_ENABLED="true"
# Sliding window length (ms)
RATE_LIMIT_WINDOW_MS="60000"
# Max GET requests per window per IP
RATE_LIMIT_MAX_REQUESTS="100"
# Max POST/PUT/PATCH/DELETE per window per IP
RATE_LIMIT_WRITE_MAX_REQUESTS="20"
# Max /api/ai/* + /api/analysis calls per window per IP
RATE_LIMIT_AI_MAX_REQUESTS="10"
# Max backtest POSTs per window per IP
RATE_LIMIT_DRAFT_MAX_REQUESTS="5"

# ============================================
# NOTIFICATIONS — TELEGRAM / DISCORD (v2)
# ============================================
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=""
# Target chat/group id (get via @userinfobot)
TELEGRAM_CHAT_ID=""
# Discord webhook URL (channel → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=""
# Minimum severity that triggers dispatch: INFO | WARN | ERROR | CRITICAL
NOTIFY_MIN_SEVERITY="WARN"
# Outbound rate caps (Telegram limit: 30 msg/s — keep sane)
NOTIFY_RATE_PER_MIN="20"
NOTIFY_RATE_PER_HOUR="100"

# ============================================
# MONITORING & METRICS (v2)
# ============================================
METRICS_ENABLED="true"
# MetricsSnapshot DB persistence interval (ms)
METRICS_SNAPSHOT_INTERVAL_MS="300000"

# ============================================
# BACKTEST ENGINE (v2)
# ============================================
# Max candles per simulation run
BACKTEST_MAX_CANDLES="50000"
# Max per-trade rows persisted per run
BACKTEST_MAX_TRADES_PERSIST="1000"

# ============================================
# TRADING DEFAULTS
# ============================================
BASE_BALANCE="10000"
# Max loss per trading session (% of equity)
SESSION_RISK_LIMIT_PCT="1.0"
