# ============================================================
# FINEX AI TRADING SYSTEM — Template Environment
#
# Pemakaian:
#   cp .env.example .env   lalu isi nilai di bawah.
#
# ATURAN PENTING:
#  - .env TIDAK di-commit (sudah di-.gitignore). File ini
#    hanyalah template TANPA rahasia.
#  - SESSION_SECRET WAJIB diisi (min. 32 karakter) — session
#    login JWT ditandatangani dengan nilai ini.
#  - Produksi: pakai ADMIN_PASSWORD_HASH (scrypt), BUKAN
#    ADMIN_PASSWORD plaintext. Generate:
#      bun run hash-password        # interaktif
#      node scripts/hash-password.mjs "PasswordKuatAnda"
#  - Tanpa ADMIN_PASSWORD_HASH / ADMIN_PASSWORD, sistem
#    memakai password default first-run "finex-admin-2025"
#    (dashboard menampilkan peringatan amber). Segera ganti.
# ============================================================

# ---------- Database (Prisma / SQLite) ----------
# Path RELATIF terhadap folder prisma/ → berfungsi identik di Windows/Linux/macOS.
# Default: <proyek>/db/custom.db
# Docker: ganti ke file:/app/db/custom.db (sesuai volume di docker-compose.yml)
DATABASE_URL=file:../db/custom.db

# ---------- Autentikasi Dashboard ----------
# Username admin (default: admin)
ADMIN_USERNAME=admin

# [PILIH SATU] Password plaintext — HANYA untuk development:
ADMIN_PASSWORD=

# [PILIH SATU] Hash scrypt untuk PRODUKSI (menimpa plaintext di atas):
# Format: scrypt:16384:8:1:<saltB64url>:<hashB64url>
ADMIN_PASSWORD_HASH=

# Kunci tanda-tangan session JWT (WAJIB, min. 32 karakter).
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ---------- Engine Python (mode LIVE) ----------
# demo  = simulator internal (tanpa MT5)
# live  = proxy ke python-engine + MetaTrader 5
ENGINE_MODE=demo

# Kunci API bersama dashboard ↔ engine. HARUS identik dengan
# field `api_key` di python-engine/config.yaml.
# Generate: openssl rand -hex 32
ENGINE_API_KEY=

# ---------- Berita (opsional, mode demo/live) ----------
# Kosongkan → dashboard memakai provider AI internal.
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# ---------- API key AI provider (opsional) ----------
# Alternatif input manual: dashboard → tab Settings → "API Key Provider AI"
# (tersimpan terenkripsi AES-256-GCM di DB; menimpa env di bawah ini).
# Nama variabel IDENTIK dengan python-engine/.env — satu .env bisa dipakai
# untuk dashboard VPS; engine di PC Windows memakai salinannya sendiri.
# ZAI_API_KEY=gsk_...
# GROQ_API_KEY=gsk_...
# TINYFISH_API_KEY=
# TINYFISH_BASE_URL=https://api.tinyfish.ai
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# TOKENPLUS_API_KEY=
# TOKENPLUS_BASE_URL=https://api.tokenplus.ai/v1
# OLLAMA_BASE_URL=http://localhost:11434
# Override model per provider (opsional):
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=qwen2.5:14b
