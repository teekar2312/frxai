# ============================================================
# FINEX Indonesia - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# Database (SQLite)
DATABASE_URL=file:/app/data/custom.db

# ============================================================
# Authentication (NextAuth.js)
# ============================================================
# REQUIRED. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL=https://your-domain.com (auto-detected in most cases)

# Allow new user registration (default: false for security)
ALLOW_REGISTRATION=false

# ============================================================
# API Authentication
# ============================================================
# Required in production. Protects all POST/PUT/PATCH/DELETE endpoints.
# Generate with: openssl rand -hex 32
API_SECRET_KEY=

# ============================================================
# Market Data Providers
# ============================================================
# Finnhub (https://finnhub.io/) - Free: 60 calls/min
FINNHUB_API_KEY=

# MARKETAUX (https://www.marketaux.com/) - Free: 100 requests/day
MARKETAUX_API_KEY=

# ============================================================
# AI Provider API Keys
# ============================================================
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Together AI (https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Tinyfish.ai (https://tinyfish.ai/)
TINYFISH_API_KEY=

# Lokal AI (local Ollama - no key needed)
LOKAL_AI_API_KEY=
LOKAL_AI_BASE_URL=

# ============================================================
# MT5 Bridge (optional - for live trading)
# ============================================================
MT5_BRIDGE_URL=http://localhost:3004
MT5_BRIDGE_SECRET=

# ============================================================
# WebSocket Price Streaming (optional)
# ============================================================
WS_PRICES_URL=http://localhost:3005

# ============================================================
# Email Notifications (Resend)
# ============================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
NOTIFICATION_EMAIL_TO=

# ============================================================
# Application
# ============================================================
# NODE_ENV is set automatically by the start script
# PORT=3000 (default, managed by Docker/infra)
