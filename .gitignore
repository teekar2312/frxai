*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
/prompt

server.log

# database (SQLite runtime data — recreate with `bun run db:push`)
db/*.db
db/*.db-journal

# internal agent / tooling artifacts
tool-results/
worklog.md
upload/
download/

# Skills directory
/skills/