// ============================================================
// FINEX Indonesia — PostgreSQL Schema
// Converted from SQLite with Decimal types and multi-tenant TradingConfig
//
// Usage:
//   prisma generate --schema=prisma/schema.postgres.prisma
//   prisma migrate dev  --schema=prisma/schema.postgres.prisma
//
// DATABASE_URL format:
//   postgresql://user:password@host:5432/dbname?schema=public
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  name            String?
  role            String        @default("user") // admin, user
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  twoFactor       UserTwoFactor?
  resetToken      String?
  resetTokenExpires DateTime?
  transactions    Transaction[]
  notifications   Notification[]
  tradingConfigs  TradingConfig[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("users")
}

model UserTwoFactor {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String    // TOTP secret (encrypted at rest)
  enabled    Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("user_two_factor")
}

// ============================================================
// Trading — Positions, Orders, Alerts
// ============================================================

model TradingPosition {
  id               String    @id @default(cuid())
  pair             String
  direction        String    // BUY or SELL
  lotSize          Decimal   @db.Decimal(10, 2)
  entryPrice       Decimal   @db.Decimal(18, 5)
  currentPrice     Decimal?  @db.Decimal(18, 5)
  stopLoss         Decimal?  @db.Decimal(18, 5)
  takeProfit       Decimal?  @db.Decimal(18, 5)
  trailingStop     Decimal?  @db.Decimal(18, 5)
  trailingType     String    @default("manual") // manual or automatic
  /// Reserved for future position risk tracking
  pipValue         Decimal?  @db.Decimal(18, 5)
  /// Reserved for future position risk tracking
  riskAmount       Decimal?  @db.Decimal(18, 2)
  /// Reserved for future position risk tracking
  rewardAmount     Decimal?  @db.Decimal(18, 2)
  pnl              Decimal   @default(0) @db.Decimal(18, 2)
  pnlPips          Decimal   @default(0) @db.Decimal(10, 2)
  status           String    @default("open") // open, closed, cancelled
  strategy         String?
  marketCondition  String?
  aiConfidence     Decimal?  @db.Decimal(5, 4)
  riskLevel        String?   // AUDIT-AI-09: low, medium, high from AI analysis
  aiRecommendation String?   // AUDIT-AI-09: BUY, SELL, HOLD, AVOID from AI
  leverage         Int       @default(100)
  commission       Decimal   @default(1) @db.Decimal(10, 2)
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  closeReason      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([pair])
  @@index([createdAt])
  @@index([status, closedAt])
  @@map("trading_positions")
}

model PendingOrder {
  id               String    @id @default(cuid())
  pair             String
  direction        String    // BUY or SELL
  orderType        String    // limit, stop, buy_stop, sell_stop, buy_limit, sell_limit
  lotSize          Decimal   @db.Decimal(10, 2)
  price            Decimal   @db.Decimal(18, 5)
  stopLoss         Decimal?  @db.Decimal(18, 5)
  takeProfit       Decimal?  @db.Decimal(18, 5)
  status           String    @default("pending") // pending, executed, cancelled, expired
  strategy         String?
  aiConfidence     Decimal?  @db.Decimal(5, 4)
  riskLevel        String?
  aiRecommendation String?
  triggeredAt      DateTime?
  cancelledAt      DateTime?
  executedAt       DateTime?
  executedPrice    Decimal?  @db.Decimal(18, 5)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([pair])
  @@index([orderType])
  @@index([createdAt])
  @@map("pending_orders")
}

model PriceAlert {
  id           String    @id @default(cuid())
  pair         String
  condition    String    // above, below, crosses_above, crosses_below
  targetPrice  Decimal   @db.Decimal(18, 5)
  currentPrice Decimal?  @db.Decimal(18, 5)
  isActive     Boolean   @default(true)
  isTriggered  Boolean   @default(false)
  triggeredAt  DateTime?
  note         String?
  emailNotify  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, isTriggered])
  @@map("price_alerts")
}

// ============================================================
// Activity & Logging
// ============================================================

model ActivityLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // info, warn, error, debug
  category  String   @default("general") // trading, analysis, alert, system, api
  message   String
  details   String?
  pair      String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([pair])
  @@map("activity_logs")
}

// ============================================================
// AI Analysis & Backtesting
// ============================================================

model AiAnalysis {
  id              String    @id @default(cuid())
  pair            String
  marketCondition String    // trending, range_bound, high_volatility, low_volatility
  confidence      Decimal   @db.Decimal(5, 4)
  recommendation  String    // buy, sell, hold, avoid
  reasoning       String
  strategyUsed    String?
  indicatorsUsed  String?   // JSON
  newsImpact      String?
  riskLevel       String    @default("medium")
  entryPrice      Decimal?  @db.Decimal(18, 5)
  stopLoss        Decimal?  @db.Decimal(18, 5)
  takeProfit      Decimal?  @db.Decimal(18, 5)
  lotSize         Decimal?  @db.Decimal(10, 2)
  aiProvider      String?   // AI-009: which provider generated this
  aiModel         String?   // AI-009: which model was used
  timeframes      String?   // JSON array of timeframes used for MTF analysis
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([pair])
  @@index([createdAt])
  @@map("ai_analyses")
}

model BacktestResult {
  id                   String    @id @default(cuid())
  name                 String
  pair                 String
  strategy             String
  timeframe            String
  startDate            DateTime
  endDate              DateTime
  initialBalance       Decimal   @db.Decimal(18, 2)
  finalBalance         Decimal   @db.Decimal(18, 2)
  totalTrades          Int
  winningTrades        Int
  losingTrades         Int
  winRate              Decimal   @db.Decimal(5, 4)
  totalPnl             Decimal   @db.Decimal(18, 2)
  maxDrawdown          Decimal   @db.Decimal(8, 4)
  sharpeRatio          Decimal?  @db.Decimal(10, 4)
  profitFactor         Decimal?  @db.Decimal(10, 4)
  avgWin               Decimal?  @db.Decimal(18, 2)
  avgLoss              Decimal?  @db.Decimal(18, 2)
  maxConsecutiveWins   Int?
  maxConsecutiveLosses Int?
  parameters           String?   // JSON
  createdAt            DateTime  @default(now())

  @@index([pair])
  @@index([createdAt])
  @@map("backtest_results")
}

// ============================================================
// News & Economic Calendar
// ============================================================

model NewsItem {
  id          String    @id @default(cuid())
  source      String
  title       String
  description String?
  url         String?
  imageUrl    String?
  publishedAt DateTime?
  category    String?
  pair        String?   // related pair if identified
  impact      String?   // high, medium, low
  sentiment   String?   // positive, negative, neutral
  analyzedAt  DateTime  @default(now())

  @@index([publishedAt])
  @@index([pair])
  @@unique([source, title])
  @@map("news_items")
}

model EconomicEvent {
  id        String   @id @default(cuid())
  date      DateTime
  time      String   // HH:mm format
  currency  String   // USD, EUR, GBP, JPY, etc.
  impact    String   // high, medium, low
  title     String
  forecast  String?  // Forecast value
  previous  String?  // Previous value
  actual    String?  // Actual value (filled after event)
  category  String?  // GDP, CPI, Employment, Interest Rate, etc.
  source    String   @default("investing")
  fetchedAt DateTime @default(now())

  @@index([date])
  @@index([currency])
  @@index([impact])
  @@index([date, currency])
  @@map("economic_events")
}

// ============================================================
// Multi-Tenant TradingConfig
// Each user can have their own config; userId=NULL is system default
// ============================================================

model TradingConfig {
  id                    String    @id @default(cuid())
  userId                String?   // NULL = system-wide default config
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskPerTrade          Decimal   @default(0.75) @db.Decimal(5, 2)
  stopLossMin           Decimal   @default(5) @db.Decimal(10, 2)
  stopLossMax           Decimal   @default(15) @db.Decimal(10, 2)
  riskRewardRatio       Decimal   @default(1.5) @db.Decimal(5, 2)
  maxOpenPositions      Int       @default(3)
  minLot                Decimal   @default(0.01) @db.Decimal(10, 2)
  maxLotPerOrder        Decimal   @default(50) @db.Decimal(10, 2)
  dailyRiskLimit        Decimal   @default(2.5) @db.Decimal(5, 2)
  dailyTargetMin        Decimal   @default(1) @db.Decimal(5, 2)
  dailyTargetMax        Decimal   @default(3) @db.Decimal(5, 2)
  leverage              Int       @default(100)
  spreadPip             Decimal   @default(0.5) @db.Decimal(10, 2)
  commissionPerLot      Decimal   @default(1) @db.Decimal(10, 2)
  marginCallLevel       Int       @default(50)
  stopOutLevel          Int       @default(20)
  autoTrading           Boolean   @default(false)
  autoTrailingStop      Boolean   @default(false)
  trailingStopPips      Decimal   @default(10) @db.Decimal(10, 2)
  avoidNewsTrading      Boolean   @default(true)
  accountBalance        Decimal   @default(10000) @db.Decimal(18, 2)
  aiProvider            String    @default("zai")  // AI-006: active AI provider
  aiModel               String    @default("default") // AI-006: active AI model
  // Email notification settings
  notifyEmail           String?   // Target email for notifications (overrides NOTIFICATION_EMAIL_TO)
  emailOnPositionOpen   Boolean   @default(false)
  emailOnPositionClose  Boolean   @default(false)
  emailOnAlertTrigger   Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId])  // At most one config per user (NULL = single system default)
  @@index([userId])
  @@map("trading_configs")
}

// ============================================================
// Notifications
// ============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String    // signal, alert, position_open, position_close, system, auto_trade
  title     String
  message   String
  pair      String?
  data      String?   // JSON string for additional data
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead, createdAt])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// Watchlist
// ============================================================

model WatchlistPair {
  id        String   @id @default(cuid())
  pair      String   @unique
  addedAt   DateTime @default(now())
  sortOrder Int      @default(0)

  @@map("watchlist_pairs")
}

// ============================================================
// Signal Sharing
// ============================================================

model SharedSignal {
  id           String          @id @default(cuid())
  signalId     String?         // Reference to the original signal if stored
  pair         String
  direction    String          // BUY or SELL
  entryPrice   Decimal         @db.Decimal(18, 5)
  stopLoss     Decimal?        @db.Decimal(18, 5)
  takeProfit   Decimal?        @db.Decimal(18, 5)
  confidence   Decimal?        @db.Decimal(5, 4)
  reasoning    String?
  strategy     String?
  sharedBy     String?         // User who shared
  likes        Int             @default(0)
  commentCount Int             @default(0)
  comments     SignalComment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pair])
  @@index([createdAt])
  @@map("shared_signals")
}

model SignalComment {
  id        String       @id @default(cuid())
  signalId  String
  signal    SharedSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author    String?
  content   String
  createdAt DateTime     @default(now())

  @@index([signalId])
  @@index([createdAt])
  @@map("signal_comments")
}

// ============================================================
// Transactions (Deposits, Withdrawals, Adjustments)
// ============================================================

model Transaction {
  id            String    @id @default(cuid())
  type          String    // deposit, withdrawal, adjustment
  amount        Decimal   @db.Decimal(18, 2)
  currency      String    @default("USD")
  balanceBefore Decimal   @db.Decimal(18, 2)
  balanceAfter  Decimal   @db.Decimal(18, 2)
  description   String?
  createdBy     String?
  user          User?     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now())

  @@map("transactions")
}
