generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE TRADING MODELS
// ============================================

model Trade {
  id              String   @id @default(cuid())
  symbol          String
  direction       String   // BUY or SELL
  lotSize         Float
  entryPrice      Float
  currentPrice    Float
  sl              Float?
  tp              Float?
  trailingStop    Boolean  @default(false)
  trailingDist    Float?
  // --- Trailing Stop Deep Audit fields ---
  trailingSteps       String?  // JSON: TrailingStep[] for tiered trailing
  trailingAdjustments Int     @default(0)  // Number of SL adjustments made by trailing
  trailingActivatedAt  DateTime? // When trailing stop first activated
  trailingCooldownSec  Int     @default(5)  // Min seconds between SL adjustments (throttle)
  pnl             Float    @default(0)
  pnlPercent      Float    @default(0)
  status          String   @default("OPEN") // OPEN, CLOSED, PENDING, REJECTED
  strategy        String?
  timeframe       String?
  marketCond      String?
  aiConfidence    Float?
  leverage        Int      @default(25)
  commission      Float    @default(0)
  slippage        Float    @default(0)
  margin          Float    @default(0)
  openTime        DateTime @default(now())
  closeTime       DateTime?
  closePrice      Float?
  reason          String?  // SL, TP, Manual, Trailing Stop, AI Signal, Margin Call, Stop Out, Risk Reject
  rejectReason    String?  // Why trade was rejected by risk engine
  mt5ErrorCode    Int?     // MT5 trade_return_code if rejected by broker
  mt5ErrorDesc    String?  // Human-readable MT5 error description
  sizingMethod    String?  // Which money management method was used
  riskAmount      Float?   // Dollar risk at trade open
  sector          String?  // Sector classification for correlation
  // --- Phase 5: Trade Execution Engine ---
  parentId        String?  // For partial closes: references the original trade
  originalLotSize Float?   // Lot size before any partial closes
  partialCloses   Int      @default(0) // Number of partial closes executed
  highestPrice    Float?   // Track highest price since open (for trailing stop)
  lowestPrice     Float?   // Track lowest price since open (for trailing stop)
  lastSlAdjust    DateTime? // Last time SL was adjusted by trailing stop
  breakEvenApplied Boolean  @default(false) // Whether break-even floor was applied
  executionState  String   @default("FILLED") // FILLED, PARTIAL_FILLED, PENDING_CANCEL, CANCELLED
  indicatorSnapshot String? @default("{}") // JSON: indicator values at trade open
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PriceAlert {
  id          String   @id @default(cuid())
  symbol      String
  condition   String   // ABOVE, BELOW, CROSS_UP, CROSS_DOWN
  price       Float
  message     String?
  triggered   Boolean  @default(false)
  triggeredAt DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================
// MT5 CONNECTION MANAGEMENT
// ============================================

model Mt5ConnectionState {
  id              String   @id @default(cuid())
  status          String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, RECONNECTING, ERROR, AUTH_FAILED, DEGRADED, CIRCUIT_OPEN
  broker          String   @default("FINEX Indonesia")
  server          String?
  accountNumber   String?
  accountType     String   @default("Real")
  latencyMs       Int      @default(0)
  uptimeSeconds   Int      @default(0)
  reconnectCount  Int      @default(0)
  lastHeartbeat   DateTime?
  lastError       String?
  lastConnectedAt DateTime?
  lastDisconnectedAt DateTime?
  connectedAt     DateTime?
  consecutiveHeartbeatFailures Int @default(0)
  isMarketOpen    Boolean  @default(false)
  tradingPhase    String   @default("CLOSED") // PRE_OPEN, OPEN, PRE_CLOSE, CLOSED, AFTER_HOURS
  // Phase 3: Circuit Breaker
  circuitState        String   @default("CLOSED") // CLOSED (normal), OPEN (tripped), HALF_OPEN (probing)
  circuitFailureCount Int      @default(0)
  circuitLastFailure  DateTime?
  circuitOpenUntil    DateTime?
  connectionQuality   Float    @default(100.0) // 0-100 quality score
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Mt5ConnectionLog {
  id          String   @id @default(cuid())
  event       String   // CONNECTED, DISCONNECTED, RECONNECTING, AUTH_FAILED, TIMEOUT, HEARTBEAT_OK, HEARTBEAT_FAIL, ERROR, DEGRADED, RECOVERED, MARKET_OPEN, MARKET_CLOSE, CIRCUIT_OPEN, CIRCUIT_HALF_OPEN, CIRCUIT_CLOSED, ORDER_RETRY, ORDER_FAILED, ORDER_EXECUTED
  message     String
  details     String?
  latencyMs   Int?
  createdAt   DateTime @default(now())
}

model Mt5ErrorCode {
  code        Int    @id // MT5 trade_return_code (10004-10036)
  description String
  severity    String @default("ERROR") // INFO, WARN, ERROR, CRITICAL, FATAL
  category    String @default("TRADE_EXECUTION") // MT5_CONNECTION, TRADE_EXECUTION, DATA_FEED
  remediation String // Auto-remediation action
  retryable   Boolean @default(false)
  createdAt   DateTime @default(now())
}

// ============================================
// RISK MANAGEMENT
// ============================================

model RiskEvent {
  id            String   @id @default(cuid())
  eventType     String   // DAILY_LIMIT_APPROACHING, DAILY_LIMIT_REACHED, MARGIN_CALL_WARNING, STOP_OUT_WARNING, MARGIN_EXCEEDED, POSITION_LIMIT_REACHED, LOT_LIMIT_EXCEEDED, RISK_SCORE_HIGH, CORRELATION_RISK, DRAWDOWN_LIMIT, PROACTIVE_MC_70, PROACTIVE_MC_60, LEVERAGE_CAP, CONCENTRATION_LIMIT, PORTFOLIO_RISK_CAP, SLIPPAGE_WARNING, GAP_RISK, VOLATILITY_REGIME_CHANGE, CONSECUTIVE_LOSS_HALT, EQUITY_CURVE_HALT
  severity      String   // LOW, MEDIUM, HIGH, CRITICAL
  message       String
  details       String?
  actionTaken   String?  // TRADE_BLOCKED, ALL_POSITIONS_CLOSED, REDUCED_SIZE, NOTIFICATION_SENT, NONE, AUTO_RECONNECT, AUTO_RESOLVED
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  autoResolveAt DateTime? // Phase 3: When this event should auto-resolve
  createdAt     DateTime @default(now())
}

model RiskConfig {
  id                String   @id @default(cuid())
  name              String   @unique @default("default")
  maxRiskPerTrade   Float    @default(0.5)   // % of equity
  maxDailyLoss      Float    @default(2.0)   // % of equity
  maxWeeklyLoss     Float    @default(5.0)   // % of equity
  maxMonthlyLoss    Float    @default(10.0)  // % of equity
  maxMarginUsage    Float    @default(50.0)  // % of equity
  maxDrawdown       Float    @default(10.0)  // % of peak equity
  maxOpenPositions  Int      @default(200)
  maxLotPerTrade    Float    @default(50.0)
  maxLotPerSymbol   Float    @default(100.0)
  marginCallLevel   Float    @default(50.0)  // %
  stopOutLevel      Float    @default(20.0)  // %
  maxCorrelatedExposure Float  @default(15.0) // % max for same-sector positions
  cooldownAfterLossMinutes Int @default(15)
  // --- Deep audit Phase 2 fields ---
  proactiveMcLevel70    Boolean @default(true)
  proactiveMcLevel60    Boolean @default(true)
  maxPortfolioRiskPct    Float   @default(5.0)
  maxLeveragePerTrade    Float   @default(10.0)
  maxSingleStockPct      Float   @default(5.0)
  maxSectorPct           Float   @default(15.0)
  slippageTolerancePips  Float   @default(3.0)
  reserveCapitalPct      Float   @default(20.0)
  // --- Phase 3: Gap Risk ---
  gapRiskMaxPct          Float   @default(3.0)   // Max overnight gap risk tolerance %
  gapRiskAlertPct        Float   @default(2.0)   // Alert threshold for gap risk %
  // --- Phase 3: Volatility Regime ---
  volatilityRegimeEnabled Boolean @default(true)
  highVolRiskReduction  Float   @default(0.5)   // Reduce risk by 50% in HIGH_VOLATILITY
  lowVolRiskReduction   Float   @default(0.8)   // Reduce risk by 20% in LOW_VOLATILITY
  // --- Phase 3: Consecutive Loss ---
  maxConsecutiveLosses  Int     @default(5)     // Halt after N consecutive losses
  consecutiveLossCooldownMinutes Int @default(60) // Cooldown after halt
  // --- Phase 3: Equity Curve ---
  equityCurveEnabled     Boolean @default(true)
  equityCurveMaPeriod    Int     @default(20)    // Moving average period for equity curve
  // --- Phase 3: Session Risk ---
  sessionRiskLimitPct    Float   @default(1.0)   // Max loss per trading session % of equity
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// ============================================
// MONEY MANAGEMENT
// ============================================

model DailyPerformance {
  id            String   @id @default(cuid())
  date          String   @unique  // YYYY-MM-DD
  startBalance  Float
  endBalance    Float
  realizedPnl   Float    @default(0)
  unrealizedPnl Float    @default(0)
  totalPnl      Float    @default(0)
  pnlPercent    Float    @default(0)
  tradesOpened  Int      @default(0)
  tradesClosed  Int      @default(0)
  winTrades     Int      @default(0)
  lossTrades    Int      @default(0)
  maxDrawdown   Float    @default(0)
  peakEquity    Float
  troughEquity  Float
  riskScoreAvg  Float    @default(0)
  // --- Phase 2 fields ---
  commissionPaid     Float    @default(0)
  slippageCost       Float    @default(0)
  deployedCapital    Float    @default(0)
  reserveCapital     Float    @default(0)
  sizingMethodUsed   String   @default("FIXED_FRACTIONAL")
  scalingFactor      Float    @default(1.0)
  // --- Phase 3: Consecutive Loss & Equity Curve ---
  consecutiveLosses     Int     @default(0)
  maxConsecutiveLosses  Int     @default(0)
  equityCurveStatus      String  @default("NORMAL") // NORMAL, BELOW_MA (halt), RECOVERING
  equityCurveMaValue     Float   @default(0)
  sessionPnl             Float   @default(0)  // P&L for current session
  sessionTrades          Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// AI & BACKTESTING
// ============================================

model AiAnalysis {
  id              String   @id @default(cuid())
  symbol          String
  marketCondition String   // TRENDING, RANGE_BOUND, HIGH_VOLATILITY, LOW_VOLATILITY
  confidence      Float
  timeframe       String
  trendDirection  String?  // UP, DOWN, SIDEWAYS
  volatility      Float?
  volumeAnalysis  String?
  sentiment       String?
  recommendations String   @default("[]") // JSON array
  factors         String   @default("[]") // JSON array of analysis factors
  createdAt       DateTime @default(now())
}

model BacktestResult {
  id              String   @id @default(cuid())
  name            String
  symbol          String
  strategy        String
  timeframe       String
  startDate       DateTime
  endDate         DateTime
  initialCapital  Float
  finalCapital    Float
  totalTrades     Int
  winTrades       Int
  lossTrades      Int
  winRate         Float
  maxDrawdown     Float
  sharpeRatio     Float?
  profitFactor    Float?
  avgWin          Float?
  avgLoss         Float?
  totalPnl        Float
  config          String   @default("{}") // JSON strategy config
  createdAt       DateTime @default(now())
}

// ============================================
// NEWS & NOTIFICATIONS
// ============================================

model NewsArticle {
  id             String   @id @default(cuid())
  title          String
  content        String?
  source         String?
  url            String?
  imageUrl       String?
  sentiment      String   @default("NEUTRAL")
  sentimentScore Float    @default(0)
  symbols        String   @default("[]")
  publishedAt    DateTime?
  fetchedAt      DateTime @default(now())
  category       String?
  createdAt      DateTime @default(now())
}

model EmailNotification {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String   @default("PENDING")
  sentAt    DateTime?
  error     String?
  createdAt DateTime @default(now())
}

// ============================================
// STRUCTURED LOGGING
// ============================================

model TradingLog {
  id          String   @id @default(cuid())
  level       String
  category    String   @default("SYSTEM")
  message     String
  source      String?
  details     String?
  stackTrace  String?
  tradeId     String?
  symbol      String?
  metadata    String   @default("{}")
  fingerprint  String?
  createdAt   DateTime @default(now())
}

// ============================================
// API RATE LIMIT TRACKING
// ============================================

model ApiRateLimit {
  id            String   @id @default(cuid())
  service       String
  callsThisMinute Int    @default(0)
  callsThisHour   Int    @default(0)
  limitPerMinute Int    @default(60)
  limitPerHour   Int    @default(3600)
  lastCallAt     DateTime?
  warningSentAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// PHASE 3: AUDIT TRAIL
// ============================================

model AuditTrail {
  id          String   @id @default(cuid())
  action      String   // CONFIG_UPDATED, RISK_OVERRIDE, TRADING_ENABLED, TRADING_DISABLED, SYSTEM_SHUTDOWN, MANUAL_INTERVENTION
  category    String   // RISK_CONFIG, MONEY_MANAGEMENT, MT5_CONNECTION, SYSTEM, TRADE_EXECUTION
  fieldName   String?  // Which config field changed
  oldValue    String?  // Previous value
  newValue    String?  // New value
  reason      String?  // Why the change was made
  performedBy String   @default("SYSTEM") // SYSTEM, USER, AUTO_RECOVERY
  createdAt   DateTime @default(now())
}

// ============================================
// PHASE 3: ESCALATION PIPELINE
// ============================================

model EscalationEvent {
  id              String   @id @default(cuid())
  triggerLevel    String   // ERROR, CRITICAL, FATAL
  triggerCategory String
  triggerMessage  String
  escalationLevel Int      @default(1) // 1=logged, 2=alert sent, 3=recovery attempted, 4=emergency action
  actions         String   @default("[]") // JSON array of actions taken
  resolved        Boolean  @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
}

// ============================================
// PHASE 5: SESSION MANAGER
// ============================================

model SessionEvent {
  id            String   @id @default(cuid())
  sessionType   String   // FOREX, IDX_MORNING, IDX_AFTERNOON, IDX_FULL
  fromPhase     String   // Previous trading phase
  toPhase       String   // New trading phase
  eventAction   String   // SESSION_OPEN, SESSION_CLOSE, PHASE_TRANSITION, SESSION_LIMIT_REACHED
  details       String?
  createdAt     DateTime @default(now())
}

model SessionPerformance {
  id            String   @id @default(cuid())
  date          String   // YYYY-MM-DD
  sessionType   String   // MORNING, AFTERNOON, FULL_DAY
  tradesOpened  Int      @default(0)
  tradesClosed  Int      @default(0)
  winTrades     Int      @default(0)
  lossTrades    Int      @default(0)
  pnl           Float    @default(0)
  winRate       Float    @default(0)
  avgPnl        Float    @default(0)
  bestTrade     Float    @default(0)
  worstTrade    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, sessionType])
}

// ============================================
// PHASE 5: OHLCV CANDLE DATA
// ============================================

model CandleData {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String   // M1, M5, M15, H1, H4, D1
  openTime  DateTime // Candle open timestamp
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Int      @default(0)

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime(sort: Desc)])
}

// ============================================
// PHASE 5: PENDING ORDERS
// ============================================

model PendingOrder {
  id            String   @id @default(cuid())
  orderId       String?  // MT5 order ticket once submitted
  symbol        String
  orderType     String   // MARKET, LIMIT, STOP, STOP_LIMIT
  direction     String   // BUY or SELL
  lotSize       Float
  price         Float?  // Limit/stop price (null for market orders)
  sl            Float?
  tp            Float?
  status        String   @default("PENDING") // PENDING, SUBMITTED, PARTIAL_FILLED, FILLED, CANCELLED, REJECTED, EXPIRED
  reason        String?  // If rejected/cancelled
  mt5ErrorCode  Int?
  mt5ErrorDesc  String?
  strategy      String?
  timeframe     String?
  linkedTradeId String?  // Trade ID once filled
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// PHASE 6: NEWS API (FINNHUB / MARKETAUX)
// ============================================

model NewsSourceConfig {
  id              String   @id @default(cuid())
  provider        String   @unique // FINNHUB, MARKETAUX
  apiKey          String
  baseUrl         String
  enabled         Boolean  @default(true)
  priority        Int      @default(0) // Higher = used first
  rateLimitPerMin Int      @default(60)
  rateLimitPerDay Int      @default(1000)
  lastCallAt      DateTime?
  callsThisMinute Int      @default(0)
  callsThisDay    Int      @default(0)
  lastError       String?
  consecutiveErrors Int    @default(0)
  circuitState    String   @default("CLOSED") // CLOSED (normal), OPEN (tripped), HALF_OPEN
  circuitOpenUntil DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsFetchLog {
  id              String   @id @default(cuid())
  provider        String   // FINNHUB, MARKETAUX
  endpoint        String
  statusCode      Int?
  responseTimeMs  Int
  articlesFetched Int      @default(0)
  articlesNew     Int      @default(0)
  articlesDedup   Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())
}

// ============================================
// PHASE 6: SENTIMENT FILTER
// ============================================

model SentimentSnapshot {
  id              String   @id @default(cuid())
  symbol          String   // "MARKET" for aggregate, or specific ticker
  overallScore    Float    // -100 to +100
  articleCount    Int      @default(0)
  positiveCount   Int      @default(0)
  negativeCount   Int      @default(0)
  neutralCount    Int      @default(0)
  sentimentRegime String   @default("NEUTRAL") // BULLISH, BEARISH, NEUTRAL, EXTREME_FEAR, EXTREME_GREED
  confidence      Float    @default(0) // 0-100
  weightedScore   Float    @default(0) // Time-decay weighted
  topPositiveWords  String  @default("[]") // JSON: top positive keywords
  topNegativeWords  String  @default("[]") // JSON: top negative keywords
  sectorBreakdown  String  @default("{}") // JSON: sentiment by sector
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([symbol, timestamp(sort: Desc)])
}

model SentimentKeyword {
  id              String   @id @default(cuid())
  word            String   @unique
  category        String   // POSITIVE, NEGATIVE, INTENSIFIER, NEGATOR, FINANCIAL_POSITIVE, FINANCIAL_NEGATIVE
  weight          Float    @default(1.0)
  language        String   @default("EN") // EN, ID
  createdAt       DateTime @default(now())
}

// ============================================
// PHASE 6: AI DECISION ENGINE
// ============================================

model DecisionLog {
  id              String   @id @default(cuid())
  symbol          String
  decision        String   // BUY, SELL, HOLD, SKIP, REDUCE, CLOSE_ALL
  confidence      Float    // 0-100
  reasoning       String   // Human-readable explanation
  factors         String   @default("{}") // JSON: { technical: {...}, sentiment: {...}, news: {...}, risk: {...} }
  signalSources   String   @default("[]") // JSON: which signals contributed
  riskScore       Float    @default(0)
  sentimentScore  Float    @default(0)
  volatilityRegime String  @default("NORMAL")
  strategyUsed    String?
  timeframe       String?
  finalAction     String   // What was actually executed
  overridden      Boolean  @default(false)
  overrideReason  String?
  pnlImpact      Float?   // P&L if trade was taken
  createdAt       DateTime @default(now())

  @@index([symbol, createdAt(sort: Desc)])
  @@index([decision, createdAt(sort: Desc)])
}

model AiDecisionConfig {
  id                String   @id @default(cuid())
  name              String   @unique @default("default")
  minConfidenceBuy  Float    @default(65.0)  // Minimum confidence to BUY
  minConfidenceSell Float    @default(65.0)  // Minimum confidence to SELL
  sentimentWeight   Float    @default(0.25)  // Weight of sentiment in final score
  technicalWeight   Float    @default(0.50)  // Weight of technical analysis
  newsWeight        Float    @default(0.25)  // Weight of news impact
  maxPositionsPerDecision Int @default(3)
  cooldownSeconds   Int      @default(300)   // Min seconds between decisions for same symbol
  extremeSentimentBlock Boolean @default(true) // Block trades in extreme sentiment
  volatilityScalingEnabled Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
