generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          String   @default("user") // admin, user
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  twoFactor     UserTwoFactor?
  resetToken     String?
  resetTokenExpires DateTime?
  transactions  Transaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserTwoFactor {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret        String   // TOTP secret (encrypted at rest)
  enabled       Boolean  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TradingPosition {
  id            String   @id @default(cuid())
  pair          String
  direction     String   // BUY or SELL
  lotSize       Float
  entryPrice    Float
  currentPrice  Float?
  stopLoss      Float?
  takeProfit    Float?
  trailingStop  Float?
  trailingType  String   @default("manual") // manual or automatic
  pipValue      Float?
  riskAmount    Float?
  rewardAmount  Float?
  pnl           Float    @default(0)
  pnlPips       Float    @default(0)
  status        String   @default("open") // open, closed, cancelled
  strategy      String?
  marketCondition String?
  aiConfidence  Float?
  riskLevel     String?   // AUDIT-AI-09: low, medium, high from AI analysis
  aiRecommendation String? // AUDIT-AI-09: BUY, SELL, HOLD, AVOID from AI
  leverage      Int      @default(100)
  commission    Float    @default(1)
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  closeReason   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([pair])
  @@index([createdAt])
  @@index([status, closedAt])
}

model PendingOrder {
  id            String   @id @default(cuid())
  pair          String
  direction     String   // BUY or SELL
  orderType     String   // limit, stop, buy_stop, sell_stop, buy_limit, sell_limit
  lotSize       Float
  price         Float   // Target price for the order
  stopLoss      Float?
  takeProfit    Float?
  status        String   @default("pending") // pending, executed, cancelled, expired
  strategy      String?
  aiConfidence  Float?
  riskLevel     String?
  aiRecommendation String?
  triggeredAt   DateTime?
  cancelledAt   DateTime?
  executedAt    DateTime?
  executedPrice Float?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([pair])
  @@index([orderType])
  @@index([createdAt])
}

model PriceAlert {
  id          String   @id @default(cuid())
  pair        String
  condition   String   // above, below, crosses_above, crosses_below
  targetPrice Float
  currentPrice Float?
  isActive    Boolean  @default(true)
  isTriggered Boolean  @default(false)
  triggeredAt DateTime?
  note        String?
  emailNotify Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isTriggered])
}

model ActivityLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // info, warn, error, debug
  category  String   @default("general") // trading, analysis, alert, system, api
  message   String
  details   String?
  pair      String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([pair])
}

model AiAnalysis {
  id              String   @id @default(cuid())
  pair            String
  marketCondition String   // trending, range_bound, high_volatility, low_volatility
  confidence      Float
  recommendation  String   // buy, sell, hold, avoid
  reasoning       String
  strategyUsed    String?
  indicatorsUsed  String?  // JSON
  newsImpact      String?
  riskLevel       String   @default("medium")
  entryPrice      Float?
  stopLoss        Float?
  takeProfit      Float?
  lotSize         Float?
  aiProvider      String?  // AI-009: which provider generated this
  aiModel         String?  // AI-009: which model was used
  timeframes      String?  // JSON array of timeframes used for MTF analysis
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([pair])
  @@index([createdAt])
}

model BacktestResult {
  id              String   @id @default(cuid())
  name            String
  pair            String
  strategy        String
  timeframe       String
  startDate       DateTime
  endDate         DateTime
  initialBalance  Float
  finalBalance    Float
  totalTrades     Int
  winningTrades   Int
  losingTrades    Int
  winRate         Float
  totalPnl        Float
  maxDrawdown     Float
  sharpeRatio     Float?
  profitFactor    Float?
  avgWin          Float?
  avgLoss         Float?
  maxConsecutiveWins  Int?
  maxConsecutiveLosses Int?
  parameters      String?  // JSON
  createdAt       DateTime @default(now())

  @@index([pair])
  @@index([createdAt])
}

model NewsItem {
  id            String   @id @default(cuid())
  source        String
  title         String
  description   String?
  url           String?
  imageUrl      String?
  publishedAt   DateTime?
  category      String?
  pair          String?  // related pair if identified
  impact        String?  // high, medium, low
  sentiment     String?  // positive, negative, neutral
  analyzedAt    DateTime @default(now())

  @@index([publishedAt])
  @@index([pair])
  @@unique([source, title])
}

model TradingConfig {
  id                    String   @id @default("default")
  riskPerTrade          Float    @default(0.75)
  stopLossMin           Float    @default(5)
  stopLossMax           Float    @default(15)
  riskRewardRatio       Float    @default(1.5)
  maxOpenPositions      Int      @default(3)
  minLot                Float    @default(0.01)
  maxLotPerOrder        Float    @default(50)
  dailyRiskLimit        Float    @default(2.5)
  dailyTargetMin        Float    @default(1)
  dailyTargetMax        Float    @default(3)
  leverage              Int      @default(100)
  spreadPip             Float    @default(0.5)
  commissionPerLot      Float    @default(1)
  marginCallLevel       Int      @default(50)
  stopOutLevel          Int      @default(20)
  autoTrading           Boolean  @default(false)
  autoTrailingStop      Boolean  @default(false)
  trailingStopPips      Float    @default(10)
  avoidNewsTrading      Boolean  @default(true)
  accountBalance        Float    @default(10000)
  aiProvider            String   @default("zai")  // AI-006: active AI provider
  aiModel               String   @default("default") // AI-006: active AI model
  // Email notification settings
  notifyEmail           String?  // Target email for notifications (overrides NOTIFICATION_EMAIL_TO)
  emailOnPositionOpen   Boolean  @default(false)
  emailOnPositionClose  Boolean  @default(false)
  emailOnAlertTrigger   Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // signal, alert, position_open, position_close, system, auto_trade
  title       String
  message     String
  pair        String?
  data        String?  // JSON string for additional data
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead, createdAt])
  @@index([type])
  @@index([createdAt])
}

model EconomicEvent {
  id          String   @id @default(cuid())
  date        DateTime
  time        String   // HH:mm format
  currency    String   // USD, EUR, GBP, JPY, etc.
  impact      String   // high, medium, low
  title       String
  forecast    String?  // Forecast value
  previous    String?  // Previous value
  actual      String?  // Actual value (filled after event)
  category    String?  // GDP, CPI, Employment, Interest Rate, etc.
  source      String   @default("investing")
  fetchedAt   DateTime @default(now())

  @@index([date])
  @@index([currency])
  @@index([impact])
  @@index([date, currency])
}

model WatchlistPair {
  id        String   @id @default(cuid())
  pair      String   @unique
  addedAt   DateTime @default(now())
  sortOrder Int      @default(0)
}

model SharedSignal {
  id            String   @id @default(cuid())
  signalId      String?  // Reference to the original signal if stored
  pair          String
  direction     String   // BUY or SELL
  entryPrice    Float
  stopLoss      Float?
  takeProfit    Float?
  confidence    Float?
  reasoning     String?
  strategy      String?
  sharedBy      String?  // User who shared
  likes         Int      @default(0)
  commentCount  Int      @default(0)
  comments      SignalComment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pair])
  @@index([createdAt])
}

model SignalComment {
  id          String   @id @default(cuid())
  signalId    String
  signal      SharedSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author      String?
  content     String
  createdAt   DateTime @default(now())

  @@index([signalId])
  @@index([createdAt])
}

model Transaction {
  id            String   @id @default(cuid())
  type          String   // deposit, withdrawal, adjustment
  amount        Float
  currency      String   @default("USD")
  balanceBefore Float
  balanceAfter  Float
  description   String?
  createdBy     String?
  user          User?    @relation(fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
}
